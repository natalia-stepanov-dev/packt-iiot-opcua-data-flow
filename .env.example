# Copy this file to .env and replace the placeholders. Do not commit .env
# Create a value: openssl rand -hex 32

# InfluxDB admin password, at least 8 characters
INFLUX_PASSWORD=<password>
# InfluxDB admin token. InfluxDB 2.9 stores only a hash: the token cannot be read later
INFLUX_ADMIN_TOKEN=<token>
