    {
        "id": "3d5570da6e96c017",
        "type": "function",
        "z": "b1828014b1a97944",
        "name": "find namespace",
        "func": "// subscriptionId is a known service message from the client\nif (msg.topic === \"subscriptionId\") {\n    return null;\n}\n\n// Anything else without a list is a problem. Someone must see it\nif (!Array.isArray(msg.payload)) {\n    node.error(`no namespace list, status ${JSON.stringify(msg.statusCode)}`, msg);\n    return null;\n}\n\nconst NAMESPACE_URI = \"urn:iiot-edge-gateway\";\nconst NODE_IDS = [\n    \"Gateway.Cpu.Usage\",\n    \"Gateway.Cpu.Temperature\",\n    \"Gateway.Memory.Usage\",\n    \"Gateway.Disk.Usage\",\n    \"Gateway.Uptime\",\n];\n\nconst index = msg.payload.indexOf(NAMESPACE_URI);\n// Better no data than data from another server\nif (index === -1) {\n    node.error(`namespace ${NAMESPACE_URI} not found`);\n    return null;\n}\n\nconst previous = flow.get(\"ns\");\n// After a reconnect the list comes again. Same index, nothing to do\nif (index === previous) {\n    return null;\n}\n\n// The filter uses the new index at once, so old data stops now\nflow.set(\"ns\", index);\n\nif (previous !== undefined) {\n    node.warn(`namespace index changed from ${previous} to ${index}, restarting flows`);\n    // Only a restart removes old subscriptions inside the OPC UA nodes\n    return [null, {\n        method: \"POST\",\n        url: \"http://127.0.0.1:1880/flows\",\n        headers: { \"Node-RED-Deployment-Type\": \"reload\", \"Content-Type\": \"application/json\" },\n        payload: \"{}\",\n    }];\n}\n\nconst subscriptions = NODE_IDS.map((id) => ({ topic: `ns=${index};s=${id}`, payload: \"\" }));\nreturn [subscriptions, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Flow memory survives a deploy, so start without an old index\nflow.set(\"ns\", undefined);",
